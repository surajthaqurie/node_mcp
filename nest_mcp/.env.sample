PORT=3000

# Database — use a single connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nest_mcp

# JWT
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=7d

# ─── Ollama (local LLM) ────────────────────────────────────────────────────
# URL of your running Ollama instance (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Ollama model to use for MCP chat — must be pulled locally first
# Recommended models with tool-calling support:
#   qwen2.5:1.5b   (lightweight, fast)
#   qwen2.5:7b     (better reasoning, requires more RAM)
#   mistral:7b     (good balance)
#   llama3.2:3b    (Meta model, solid performance)
OLLAMA_MODEL=qwen2.5:1.5b

# Optional: Bearer token if your Ollama instance requires authentication
# OLLAMA_API_KEY=your_ollama_api_key_here
